{
  "name": "shiki-transformer-inlay-iconify",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.5.2",
  "description": "Shiki transformer that renders inline Iconify preview",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/shiki-transformer-inlay-iconify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/shiki-transformer-inlay-iconify.git"
  },
  "bugs": "https://github.com/antfu/shiki-transformer-inlay-iconify/issues",
  "keywords": [
    "shiki",
    "shiki-transformer"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@shikijs/core": "^3.1.0",
    "@shikijs/types": "^3.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.6.0",
    "@antfu/ni": "^23.3.1",
    "@antfu/utils": "^9.1.0",
    "@iconify-json/carbon": "^1.2.8",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.2",
    "@iconify/collections": "^1.0.525",
    "@types/node": "^22.13.9",
    "bumpp": "^10.0.3",
    "eslint": "^9.21.0",
    "esno": "^4.8.0",
    "lint-staged": "^15.4.3",
    "pnpm": "^10.5.2",
    "shiki": "^3.1.0",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "unbuild": "^3.5.0",
    "unocss": "^66.0.0",
    "vite": "^6.2.0",
    "vitepress": "^2.0.0-alpha.3",
    "vitest": "^3.0.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
